# Copy this file to .env before running `docker compose up`.
# docker-compose.yml reads these to configure Mongo, the backend, and the
# frontend build.

# --- MongoDB ---
MONGO_DB=visiontrack
MONGO_URI=mongodb://mongo:27017

# --- Backend (FastAPI, served from the notebook) ---
API_PORT=8000
SNAPSHOT_INTERVAL_SECONDS=2.0
VISIONTRACK_CONFIDENCE_THRESHOLD=0.5
VISIONTRACK_TRACKER_FRAME_RATE=3.0
VISIONTRACK_LINE_Y=300
# Origins the backend will accept browser requests from.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# --- Frontend (Vite; baked in at build time) ---
# Point this at wherever the backend is reachable FROM THE BROWSER
# (not from inside the Docker network) -- e.g. http://localhost:8000 for a
# local docker compose setup, or your deployed API's public URL.
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=8080
